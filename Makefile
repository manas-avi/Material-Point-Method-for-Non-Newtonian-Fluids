all: Makefile $(TARGET)

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents src/BallObstacle.hpp src/BoxObstacle.hpp src/Camera.hpp src/CameraObject.hpp src/CameraPerso.hpp src/Cube.hpp src/Cylinder.hpp src/CylinderObstacle.hpp src/DataFile.hpp src/error.hpp src/ExceptionSimu.hpp src/Grid.hpp src/Input.hpp src/mpm_conf.hpp src/Object.hpp src/Obstacle.hpp src/OpenBoxObstacle.hpp src/OutBoxObstacle.hpp src/Particule.hpp src/PlaneObstacle.hpp src/PoissonGenerator.hpp src/Scene.hpp src/sceneLoader.hpp src/Shader.hpp src/Simulation.hpp src/Skybox.hpp src/Sphere.hpp src/SphereObstacle.hpp src/Tensor.hpp src/Texture.hpp src/Times.hpp src/utils.hpp src/common.h $(DISTDIR)/
	$(COPY_FILE) --parents src/BallObstacle.cpp src/BoxObstacle.cpp src/Camera.cpp src/CameraObject.cpp src/CameraPerso.cpp src/Cube.cpp src/Cylinder.cpp src/CylinderObstacle.cpp src/DataFile.cpp src/error.cpp src/Grid.cpp src/Input.cpp src/main.cpp src/mpm_conf.cpp src/Object.cpp src/Obstacle.cpp src/OpenBoxObstacle.cpp src/OutBoxObstacle.cpp src/Particule.cpp src/PlaneObstacle.cpp src/PoissonGenerator.cpp src/Scene.cpp src/Shader.cpp src/Simulation.cpp src/Skybox.cpp src/Sphere.cpp src/SphereObstacle.cpp src/Tensor.cpp src/Texture.cpp src/Times.cpp src/utils.cpp $(DISTDIR)/


